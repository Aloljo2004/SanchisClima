{
  "expo": {
    "name": "EntradaSanchis",
    "slug": "entrada-sanchis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usa Face ID o Touch ID para iniciar sesión de forma rápida y segura en Siscentro."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "VIBRATE",
        "android.permission.VIBRATE"
      ],
      "package": "com.tusanchis.entrada"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usa Face ID o Touch ID para iniciar sesión de forma rápida y segura en Siscentro."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5ad568df-c9a6-4afd-8fc4-c1ae52816ce7"
      }
    },
    "owner": "alejandrooller"
  }
}
